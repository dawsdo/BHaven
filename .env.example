# Copy this file to .env. It is git-ignored; each teammate makes their own.

# --- Option A: hosted PostgreSQL (Supabase, Neon, RDS) ---
# Take these from your provider. On Supabase: Project Settings -> Database ->
# Connection string -> session-mode pooler. Do NOT use the direct connection:
# it is IPv6-only on the free tier and usually fails from Windows.
# Hosted providers need TLS and will not let the app create a database:
#   PGSSL=true
#   PGCREATE_DB=false

# --- Option B: the local Docker database in compose.yaml ---
# These credentials are for local development only.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=dev-postgres-password
PGDATABASE=shelterlink

# Leave both unset for local Docker; set them for a hosted database.
# PGSSL=true
# PGCREATE_DB=false

# Port for the Express API (the React dev server proxies /api to it).
PORT=3001
