# Copy this file to .env. These credentials match the local Docker Compose database.
# Change them if you use a separately installed PostgreSQL server.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=dev-postgres-password
PGDATABASE=shelterlink

# Port for the Express API (the React dev server proxies /api to it).
PORT=3001

# Signs staff sessions. Use a long random string, for example: openssl rand -hex 32
# If left blank, a new key is made on every start, so each restart signs staff out.
SESSION_SECRET=

# Password given to every seeded demo staff account. If left blank, no demo account can sign in.
# After changing it, run: npm run reset-db
SEED_STAFF_PASSWORD=
